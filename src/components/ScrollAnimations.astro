<div class="scroll-progress" aria-hidden="true"></div>

<script is:inline>
  (() => {
    const progressBar = document.querySelector('.scroll-progress');
    const animated = new Set();
    const entries = [];

    const add = (selector, variant = 'up', stagger = false) => {
      document.querySelectorAll(selector).forEach((element, index) => {
        if (animated.has(element)) return;
        animated.add(element);
        entries.push({
          element,
          variant,
          delay: stagger ? (index % 6) * 34 : 0,
          complete: false
        });
      });
    };

    add('.trust-grid > *, .difference-grid > *, .specialty-grid > *, .exam-grid > *, .content-grid > *, .reviews-grid > *, .exam-category-grid > *, .convenio-groups > *, .footer-grid > *', 'up', true);
    add('.section-heading, .body-copy, .faq-list, .convenio-search, .convenio-count');
    add('.feature-split > :first-child, .location-grid > :first-child', 'left');
    add('.feature-split > :last-child, .location-grid > :last-child', 'right');
    add('.image-panel, .map-embed', 'scale');
    add('.appointment-grid > *, .compact-cta-inner > *, .reviews-heading > *');

    const initialTransform = (variant) => {
      if (window.innerWidth <= 820) return 'translate3d(0, 64px, 0) scale(.97)';
      if (variant === 'left') return 'translate3d(-96px, 0, 0) scale(.97)';
      if (variant === 'right') return 'translate3d(96px, 0, 0) scale(.97)';
      if (variant === 'scale') return 'translate3d(0, 42px, 0) scale(.86)';
      return 'translate3d(0, 88px, 0) scale(.96)';
    };

    const applyProgress = (entry, progress) => {
      const eased = 1 - Math.pow(1 - progress, 3);
      const element = entry.element;
      const opacity = .04 + (.96 * eased);
      const blur = 11 * (1 - eased);

      let x = 0;
      let y = 88 * (1 - eased);
      let scale = .96 + (.04 * eased);

      if (window.innerWidth <= 820) {
        y = 64 * (1 - eased);
        scale = .97 + (.03 * eased);
      } else if (entry.variant === 'left') {
        x = -96 * (1 - eased);
        y = 0;
        scale = .97 + (.03 * eased);
      } else if (entry.variant === 'right') {
        x = 96 * (1 - eased);
        y = 0;
        scale = .97 + (.03 * eased);
      } else if (entry.variant === 'scale') {
        y = 42 * (1 - eased);
        scale = .86 + (.14 * eased);
      }

      element.style.opacity = opacity.toFixed(3);
      element.style.filter = `blur(${blur.toFixed(2)}px)`;
      element.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) scale(${scale.toFixed(4)})`;
      element.style.willChange = 'opacity, transform, filter';
    };

    const finish = (entry) => {
      entry.complete = true;
      entry.element.style.removeProperty('opacity');
      entry.element.style.removeProperty('filter');
      entry.element.style.removeProperty('transform');
      entry.element.style.removeProperty('will-change');
    };

    let frame = 0;
    const update = () => {
      frame = 0;
      const viewportHeight = window.innerHeight;
      const scrollable = document.documentElement.scrollHeight - viewportHeight;
      const pageProgress = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
      if (progressBar) progressBar.style.transform = `scaleX(${pageProgress})`;

      entries.forEach((entry) => {
        if (entry.complete) return;
        const bounds = entry.element.getBoundingClientRect();
        const start = viewportHeight * .96 - entry.delay;
        const distance = Math.max(viewportHeight * .36, 230);
        const progress = Math.max(0, Math.min((start - bounds.top) / distance, 1));

        if (progress >= .999) {
          finish(entry);
        } else {
          applyProgress(entry, progress);
        }
      });
    };

    const scheduleUpdate = () => {
      if (frame) return;
      frame = requestAnimationFrame(update);
    };

    const heroElements = document.querySelectorAll(
      '.hero-content > *, .page-hero-inner > div:first-child > *, .page-hero-visual'
    );
    heroElements.forEach((element, index) => {
      element.animate(
        [
          { opacity: 0, filter: 'blur(10px)', transform: initialTransform(index === heroElements.length - 1 ? 'scale' : 'up') },
          { opacity: 1, filter: 'blur(0)', transform: 'translate3d(0, 0, 0) scale(1)' }
        ],
        {
          duration: 1050,
          delay: 120 + (index * 115),
          easing: 'cubic-bezier(.16, 1, .3, 1)',
          fill: 'both'
        }
      );
    });

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate, { passive: true });
    document.documentElement.dataset.scrollAnimations = 'active';
    update();
  })();
</script>
