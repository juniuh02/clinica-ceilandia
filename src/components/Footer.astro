---
import WhatsAppButton from './WhatsAppButton.astro';
import { withBase } from '../lib/urls';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src={withBase('/assets/logo.svg')} width="220" height="78" alt="Clínica Ceilândia" />
      <p>Cuidado médico acessível, próximo de você.</p>
      <WhatsAppButton />
    </div>
    <div>
      <h2>Institucional</h2>
      <a href={withBase('/quem-somos/')}>Quem Somos</a>
      <a href={withBase('/estrutura/')}>Estrutura e Diferenciais</a>
    </div>
    <div>
      <h2>Atendimento</h2>
      <a href={withBase('/especialidades/')}>Especialidades</a>
      <a href={withBase('/exames/')}>Exames</a>
      <a href={withBase('/convenios/')}>Convênios</a>
      <a href={withBase('/perguntas-frequentes/')}>Perguntas Frequentes</a>
    </div>
    <div>
      <h2>Contato</h2>
      <p>QNN 18, Conjunto H, Lote 5, Loja 1, Sala 3 — Ceilândia/DF</p>
      <a href="tel:+556120234979">(61) 2023-4979</a>
      <a href="tel:+5561991117464">(61) 99111-7464</a>
      <p>Segunda a sexta, 8h às 17h30<br />Sábado, 8h às 12h</p>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© Copyright 2026 CLÍNICA CEILANDIA - CLÍNICA POPULAR</span>
    <nav aria-label="Links legais">
      <a href={withBase('/politica-de-privacidade/')}>Política de Privacidade</a>
      <a href={withBase('/termos-de-uso/')}>Termos de Uso</a>
    </nav>
    <span>Atendimento médico com hora marcada</span>
  </div>
</footer>
